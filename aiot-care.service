[Unit]
Description=AIoT Care Station Gateway Service
# Note: 'After' specifies systemd unit activation ordering, NOT an adapter hardware readiness guarantee.
After=network.target bluetooth.target dbus.service
Wants=bluetooth.target
# Bounded restart rate: maximum 5 restarts within a 60-second window
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
# Replace 'pi' with your target Linux/Pi user account
User=pi
# Working directory containing repository code
WorkingDirectory=/home/pi/aiot-care
# Virtual environment Python executable (single process; use_reloader=False in app.py avoids duplicate process)
ExecStart=/home/pi/aiot-care/venv/bin/python3 app.py

# Restart policy: bounded restart on failure with 5s backoff
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2

# Environment variables
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_DEBUG=0
Environment=PATH=/home/pi/aiot-care/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Resource and security boundaries
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiot-care

[Install]
WantedBy=multi-user.target
